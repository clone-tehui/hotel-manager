generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  RECEPTIONIST
  VIEWER
}

enum RoomStatus {
  VACANT       // trống, sẵn sàng
  RESERVED     // đã có booking
  OCCUPIED     // khách đang ở
  DIRTY        // cần dọn (sau checkout)
  MAINTENANCE  // đang bảo trì
}

enum ReservationStatus {
  PENDING          // mới tạo, chưa xác nhận
  BOOKED           // đã xác nhận
  PENDING_CHECKIN  // sắp/sẵn sàng check-in
  IN_HOUSE         // đang lưu trú
  CHECKED_OUT      // đã trả phòng
  CANCELLED        // đã huỷ
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  QR_CODE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum AddonOrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  DELIVERED
  CANCELLED
}

enum SepayWebhookStatus {
  MATCHED
  UNMATCHED
  AMOUNT_MISMATCH
  MANUAL_CONFIRMED
  IGNORED
}

enum IdType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  OTHER
}

enum GuestGender {
  MALE
  FEMALE
  NON_BINARY
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  fullName     String
  role         UserRole  @default(RECEPTIONIST)
  refreshToken String?
  isActive     Boolean   @default(true)
  isLocked     Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reservationLogs ReservationLog[]

  @@map("users")
}

// ── Buildings ─────────────────────────────────────────────────────────────────

model Building {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[]

  @@map("buildings")
}

// ── Room Types ────────────────────────────────────────────────────────────────

model RoomType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  basePrice   Decimal  @db.Decimal(12, 2)
  maxGuests   Int      @default(2)
  amenities   String[]
  isActive    Boolean  @default(true)
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("room_types")
}

// ── Rooms ─────────────────────────────────────────────────────────────────────

model Room {
  id          String     @id @default(cuid())
  number      String     // mã căn/phòng (unique per building)
  floor       Int?
  status      RoomStatus @default(VACANT)
  price       Decimal?   @db.Decimal(12, 2)
  discountablePrice Decimal? @db.Decimal(12, 2)
  monthlyCost Decimal? @db.Decimal(15, 2)
  building    Building   @relation(fields: [buildingId], references: [id])
  buildingId  String
  roomType    RoomType   @relation(fields: [roomTypeId], references: [id])
  roomTypeId  String
  description String?
  note        String?
  isActive    Boolean    @default(true)
  deletedAt   DateTime?  // soft delete
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reservations Reservation[]
  images       RoomImage[]
  addonOverrides RoomAddonProductOverride[]
  addonOrders    AddonOrder[]

  @@unique([buildingId, number])
  @@index([buildingId, isActive, deletedAt])
  @@index([roomTypeId, isActive, deletedAt])
  @@index([status, isActive, deletedAt])
  @@map("rooms")
}

// ── Guests ────────────────────────────────────────────────────────────────────

model RoomImage {
  id         String   @id @default(cuid())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId     String
  url        String
  thumbUrl   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([roomId, sortOrder])
  @@map("room_images")
}

model Guest {
  id          String      @id @default(cuid())
  fullName    String
  email       String?
  phone       String?
  gender      GuestGender?
  idType      IdType      @default(NATIONAL_ID)
  idNumber    String?   @unique
  nationality String?
  company     String?
  taxCode     String?
  address     String?
  dateOfBirth DateTime?
  notes       String?
  isVip       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reservationGuests ReservationGuest[]

  @@map("guests")
}

// ── Reservations ──────────────────────────────────────────────────────────────

model Reservation {
  id                String            @id @default(cuid())
  reservationCode   String            @unique
  room              Room              @relation(fields: [roomId], references: [id])
  roomId            String
  primaryGuestName  String
  company           String?
  checkInDate       DateTime
  checkOutDate      DateTime
  actualCheckIn     DateTime?
  actualCheckOut    DateTime?
  adults            Int               @default(1)
  children          Int               @default(0)
  ratePlanName      String?
  pricePerNight     Decimal           @db.Decimal(12, 2)
  totalNights       Int
  totalAmount       Decimal           @db.Decimal(12, 2)
  depositAmount     Decimal           @db.Decimal(12, 2) @default(0)
  discountAmount    Decimal           @db.Decimal(12, 2) @default(0)
  status            ReservationStatus @default(PENDING)
  cancelReason      String?
  cancelledAt       DateTime?
  source            String?
  threadId          String?
  notes             String?
  internalNotes     String?
  createdBy         String?
  deletedAt         DateTime?         // soft delete for drafts
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  guests   ReservationGuest[]
  payments Payment[]
  logs     ReservationLog[]
  addonOrders AddonOrder[]

  @@index([roomId, status, checkInDate, checkOutDate])
  @@index([status, checkInDate, checkOutDate])
  @@index([deletedAt, checkInDate, checkOutDate])
  @@map("reservations")
}

model ReservationGuest {
  id            String      @id @default(cuid())
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  reservationId String
  guest         Guest       @relation(fields: [guestId], references: [id])
  guestId       String
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([reservationId, guestId])
  @@map("reservation_guests")
}

model Payment {
  id            String        @id @default(cuid())
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  reservationId String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

model ReservationLog {
  id            String      @id @default(cuid())
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  reservationId String
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?
  action        String
  oldValue      Json?
  newValue      Json?
  createdAt     DateTime    @default(now())

  @@index([reservationId, createdAt])
  @@map("reservation_logs")
}

// ── Integrations ──────────────────────────────────────────────────────────────

model WebhookIntegration {
  id        String   @id @default(cuid())
  name      String
  url       String
  secret    String?
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDeliveryLog[]

  @@map("webhook_integrations")
}

model WebhookDeliveryLog {
  id           String             @id @default(cuid())
  webhook      WebhookIntegration @relation(fields: [webhookId], references: [id])
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  response     String?
  success      Boolean            @default(false)
  attemptCount Int                @default(1)
  deliveredAt  DateTime?
  createdAt    DateTime           @default(now())

  @@map("webhook_delivery_logs")
}

// ── API Keys ──────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String    // first 8 chars of key (for display)
  keyHash     String    @unique // bcrypt hash of the full key
  scopes      String[]  @default([])
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("api_keys")
}

// ── System Settings ───────────────────────────────────────────────────────────

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ── Room Sales Add-on / QR Order ─────────────────────────────────────────────

model AddonCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products AddonProduct[]

  @@index([isActive, sortOrder])
  @@map("addon_categories")
}

model AddonProduct {
  id          String   @id @default(cuid())
  category    AddonCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  name        String
  description String?
  imageUrl    String?
  price       Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomOverrides RoomAddonProductOverride[]
  orderItems    AddonOrderItem[]

  @@index([categoryId, isActive, sortOrder])
  @@map("addon_products")
}

model RoomAddonProductOverride {
  id          String   @id @default(cuid())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId      String
  product     AddonProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  isAvailable Boolean  @default(true)
  customPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roomId, productId])
  @@index([roomId, isAvailable])
  @@map("room_addon_product_overrides")
}

model AddonOrder {
  id                 String           @id @default(cuid())
  orderCode          String           @unique
  room               Room             @relation(fields: [roomId], references: [id])
  roomId             String
  reservation        Reservation?     @relation(fields: [reservationId], references: [id])
  reservationId      String?
  guestName          String?
  status             AddonOrderStatus @default(PENDING_PAYMENT)
  totalAmount        Decimal          @db.Decimal(12, 2)
  customerNote       String?
  paymentReference   String           @unique
  paidAt             DateTime?
  sepayTransactionId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items       AddonOrderItem[]
  webhookLogs SepayWebhookLog[]

  @@index([roomId, status, createdAt])
  @@index([reservationId, status, createdAt])
  @@map("addon_orders")
}

model AddonOrderItem {
  id          String      @id @default(cuid())
  order       AddonOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     AddonProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String
  unitPrice   Decimal     @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal     @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@map("addon_order_items")
}

model SepayWebhookLog {
  id              String             @id @default(cuid())
  order           AddonOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId         String?
  status          SepayWebhookStatus @default(UNMATCHED)
  amount          Decimal?           @db.Decimal(12, 2)
  transferContent String?
  transactionId   String?
  payload         Json
  error           String?
  createdAt       DateTime           @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([orderId, createdAt])
  @@map("sepay_webhook_logs")
}
